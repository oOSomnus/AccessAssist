{
  "manifest_version": 3,
  "name": "AccessAssist",
  "version": "0.1.0",
  "description": "Voice-first web reading and operation assistant for blind users",
  "minimum_chrome_version": "142",
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open AccessAssist voice assistant" },
  "permissions": ["sidePanel", "scripting", "storage", "tts", "debugger", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["launcher.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "commands": {
    "open-assistant": {
      "suggested_key": { "default": "Alt+Z" },
      "description": "Open the assistant, interrupt speech, and listen to one command"
    },
    "start-typing": {
      "suggested_key": { "default": "Alt+Shift+Y" },
      "description": "Open the assistant and start typing"
    },
    "replay-introduction": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Replay the AccessAssist introduction"
    }
  }
}
